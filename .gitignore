# This repository publishes the built site at its root. The Vite project that
# produces it lives alongside but is intentionally not tracked: run
# `npm run publish` (build + lift into the root) and commit the result.

node_modules
.vite
*.local

# source and build config are intentionally untracked
/src
/public
/tools
/app.html
/package.json
/package-lock.json
/vite.config.js
/.oxlintrc.json
/README.md

# dist is only the intermediate output - the root holds the published copy
/dist

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# The published site at the repository root is tracked normally.
#
# The Vite project that produces it is deliberately NOT tracked. Those
# exclusions live in .git/info/exclude instead of here, because oxlint reads
# .gitignore and would otherwise refuse to lint the source at all.

# build output that is only an intermediate step - the root holds the
# published copy
/dist

node_modules
.vite
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?